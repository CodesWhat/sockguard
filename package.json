{
  "name": "sockguard",
  "private": true,
  "workspaces": [
    "website",
    "docs"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "npm --workspaces --if-present test && node --test --experimental-strip-types scripts/*.test.mjs",
    "sync:analytics-routes": "node scripts/analytics-routes.mjs",
    "check:analytics-routes": "node scripts/analytics-routes.mjs --check",
    "sync:analytics-runtime": "node scripts/analytics-runtime.mjs",
    "check:analytics-runtime": "node scripts/analytics-runtime.mjs --check",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "prepare": "test -d .git && lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "knip": "6.42.1",
    "lefthook": "2.2.2",
    "turbo": "2.11.10"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.31",
      "sharp": "^0.35.0"
    },
    "postcss": "8.5.31",
    "sharp": "^0.35.0"
  },
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": ">=22.0.0"
  }
}
