{
  "private": true,
  "workspaces": [
    "website",
    "docs"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "npm --workspaces --if-present test && node --test --experimental-strip-types scripts/*.test.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "prepare": "test -d .git && lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "knip": "6.31.0",
    "lefthook": "2.1.9",
    "turbo": "2.10.8"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "^0.35.0"
    },
    "js-yaml": "^4.3.0",
    "postcss": "8.5.25",
    "sharp": "^0.35.0"
  },
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22.0.0"
  }
}
